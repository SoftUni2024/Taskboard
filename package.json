{
  "name": "taskboard-vite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --import ./scripts/sites-env.mjs ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node --import ./scripts/sites-env.mjs ./node_modules/vite/bin/vite.js build",
    "preview": "node --import ./scripts/sites-env.mjs ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "install:ci": "node scripts/install-ci.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "node scripts/test-board.mjs && node --test scripts/router.test.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
